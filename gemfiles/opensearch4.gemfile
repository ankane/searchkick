source "https://rubygems.org"

gemspec path: ".."

gem "rake"
gem "minitest"
gem "sqlite3"
gem "activerecord", "~> 8.1.0"
gem "actionpack", "~> 8.1.0"
gem "activejob", "~> 8.1.0", require: "active_job"
gem "opensearch-ruby", "4.0.0.pre.beta.5"
gem "redis-client"
gem "connection_pool"
gem "kaminari"
gem "gemoji-parser"
gem "parallel_tests"
gem "typhoeus"
